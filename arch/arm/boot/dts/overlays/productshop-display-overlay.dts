/dts-v1/;
/plugin/;

/*
 * ProductShop 12" Display Overlay - Complete Integration
 * 
 * Features:
 * - Himax HX83102E MIPI DSI display (1200x2000)
 * - Himax V3 SPI touch controller  
 * - PWM backlight control (GPIO18)
 * - All GPIO pin configurations
 * 
 * Hardware configuration:
 * - DSI1: Display interface
 * - SPI0: Touch interface  
 * - GPIO17: Display reset
 * - GPIO7:  Touch reset
 * - GPIO20: Touch interrupt
 * - GPIO18: PWM backlight
 */

/{
    compatible = "brcm,bcm2712";

    /* ========================================
     * DSI1 Display Controller & Himax Panel
     * ======================================== */
    
    dsi_frag: fragment@0 {
        target = <&dsi1>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            
            port {
                dsi_out: endpoint {
                    remote-endpoint = <&panel_in>;
                };
            };
            
            // ProductShop Himax HX83102E Panel
            panel: panel@0 {
                compatible = "himax,hx83102e", "himax,hx83102";
                reg = <0>;  // DSI virtual channel
                
                // Display reset pin - GPIO17 (active high per working config)
                reset-gpios = <&rp1_gpio 17 0>;
                
                // PWM backlight reference
                backlight = <&pwm_backlight>;
                
                // Portrait orientation (270° rotation)
                rotation = <270>;
                
                port {
                    panel_in: endpoint {
                        remote-endpoint = <&dsi_out>;
                    };
                };
            };
        };
    };

    /* ========================================
     * SPI0 Touch Controller
     * ======================================== */
    
    fragment@1 {
        target = <&rp1_spi0>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            cs-gpios = <&rp1_gpio 8 1>;  // Configure CS0 on GPIO8, active low
            pinctrl-names = "default";
            pinctrl-0 = <&spi0_pins>;
            
            himax_ts: himax_ts@0 {
                compatible = "himax,hxcommon";
                reg = <0>;
                spi-max-frequency = <10000000>;  // 10MHz
                
                // Pin control configuration for touch GPIOs
                pinctrl-names = "default";
                pinctrl-0 = <&touch_irq_pins>, <&touch_reset_pins>;
                
                // Touch panel coordinates (1200x2000)
                himax,panel-coords = <0 1200 0 2000>;
                himax,display-coords = <0 1200 0 2000>;
                
                // GPIO configuration
                himax,irq-gpio = <&rp1_gpio 20 0x2008>;  // GPIO20, IRQ_TYPE_LEVEL_LOW | IRQ_TYPE_EDGE_FALLING
                himax,rst-gpio = <&rp1_gpio 7 0x00>;    // GPIO7 - Touch reset
                
                // Interrupt configuration
                interrupt-parent = <&rp1_gpio>;
                interrupts = <20 0x2008>;  // GPIO20, IRQ_TYPE_LEVEL_LOW | IRQ_TYPE_EDGE_FALLING
                
                // ProductShop-specific configuration
                himax,proj-name = "productshop";
                productshop,rx-num = <50>;
                productshop,tx-num = <32>;
                productshop,bt-num = <0>;
                productshop,max-pt = <10>;
                productshop,int-edge = <1>;  // Edge trigger
                productshop,stylus-func = <0>;  // No stylus support
                
                // Protocol configuration
                report_type = <1>;  // Protocol B
                
                status = "okay";
            };
        };
    };

    /* ========================================
     * PWM0 Backlight Controller  
     * ======================================== */
    
    fragment@2 {
        target = <&rp1_pwm0>;
        __overlay__ {
            pinctrl-names = "default";
            pinctrl-0 = <&pwm_pins>;
            status = "okay";
        };
    };

    /* ========================================
     * GPIO Pin Configurations
     * ======================================== */
    
    fragment@3 {
        target = <&rp1_gpio>;
        __overlay__ {
            // SPI0 pins for touch interface (working legacy format)
            spi0_pins: spi0_pins {
                brcm,pins = <8 9 10 11>;  // CS, MISO, MOSI, SCLK  
                brcm,function = <4>;      // Alt0 function for SPI0
                brcm,pull = <0>;          // No pull
            };
            
            // Touch interrupt pin
            touch_irq_pins: touch_irq_pins {
                brcm,pins = <20>;         // GPIO20
                brcm,function = <0>;      // Input
                brcm,pull = <2>;          // Pull-up
            };
            
            // Touch reset pin  
            touch_reset_pins: touch_reset_pins {
                brcm,pins = <7>;          // GPIO7 
                brcm,function = <1>;      // Output
                brcm,pull = <0>;          // No pull
            };
            
            // Display reset pin
            display_reset_pins: display_reset_pins {
                brcm,pins = <17>;         // GPIO17
                brcm,function = <1>;      // Output
                brcm,pull = <0>;          // No pull
            };
            
            // PWM backlight pin
            pwm_pins: pwm_pins {
                pins = "gpio18";
                function = "pwm0";
            };
        };
    };

    /* ========================================
     * PWM Backlight Device
     * ======================================== */
    
    fragment@4 {
        target-path = "/";
        __overlay__ {
            pwm_backlight: backlight {
                compatible = "pwm-backlight";
                pwms = <&rp1_pwm0 0 25000 0>;  // 25kHz, normal polarity
                
                // Brightness levels (0-13 levels, exponential curve)
                brightness-levels = <0 4 8 16 32 48 64 96 128 160 192 224 240 255>;
                default-brightness-level = <10>;  // ~75% brightness
                
                // Power control (simplified - no external regulator reference)
                // enable-gpios = <&rp1_gpio 18 0>;  // Optional: GPIO18 as enable if needed
                
                status = "okay";
            };
        };
    };


    /* ========================================
     * Runtime Overrides
     * ======================================== */
    
    __overrides__ {
        // DSI overrides - allow switching between DSI0 and DSI1
        dsi0 = <&dsi_frag>, "target:0=",<&dsi0>;
        dsi1 = <&dsi_frag>, "target:0=",<&dsi1>;
    };
};