/dts-v1/;
/plugin/;

/{
    compatible = "brcm,bcm2712";

        // --- FRAGMENT@0: DSI Panel ---
    dsi_frag: fragment@0 {
        target = <&dsi1>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            port {
                dsi_out: endpoint { remote-endpoint = <&panel_in>; };
            };
            dsi_panel: dsi_panel@0 {
                reg = <0>;
                compatible = "oric,12.1-dsi-touch-a,4lane";
                rotation = <270>;
                // LCD reset: active-high (working configuration for ProductShop display)
                reset-gpios = <&rp1_gpio 17 0>;  // GPIO17 for LCD_RESET, GPIO_ACTIVE_HIGH
                // Link to PWM backlight for brightness control
                backlight = <&pwm_backlight>;
                pinctrl-names = "default";
                pinctrl-0 = <&lcd_reset_pins>;
                status = "okay";
                port {
                    panel_in: endpoint { remote-endpoint = <&dsi_out>; };
                };
            };
        };
    };

    // Free GPIO7 from SPI CS1 usage - removed duplicate configuration

    // GPIO Pin Configuration
    fragment@3 {
        target = <&rp1_gpio>;
        __overlay__ {
            // Display GPIO pins
            lcd_reset_pins: lcd_reset_pins {
                pins = "gpio17";      // GPIO17 (LCD_RESET) 
                function = "gpio";    // GPIO function
                bias-pull-up;         // Pull-up to keep display out of reset
                output-high;          // Ensure LCD reset is high after setup
            };
            
            pwm_pins: pwm_pins {
                pins = "gpio18";
                function = "pwm0";
            };
            
            // SPI0 data pins configuration (MISO, MOSI, SCLK)
            spi0_data_pins: spi0_data_pins {
                pins = "gpio9", "gpio10", "gpio11";  // MISO, MOSI, SCLK
                function = "spi0";                    // SPI0 function
            };

            // Touch GPIO pins - use consistent rp1_gpio syntax
            touch_irq_pins: touch_irq_pins {
                pins = "gpio20";          // Touch interrupt GPIO20
                function = "gpio";        // GPIO function
                bias-pull-up;             // Pull-up
            };
            
            touch_reset_pins: touch_reset_pins {
                pins = "gpio7";           // Touch reset GPIO7 (LCD_TOUCH_RST per ProductShop spec)
                function = "gpio";        // GPIO function
                bias-pull-up;             // Pull high initially - touch controller out of reset
                output-high;              // Set initial state to high
            };
        };
    };

    // PWM Configuration for Backlight
    fragment@4 {
        target = <&rp1_pwm0>;
        __overlay__ {
            pinctrl-names = "default";
            pinctrl-0 = <&pwm_pins>;
            status = "okay";
        };
    };

    // Backlight Device
    fragment@6 {
        target-path = "/";
        __overlay__ {
            pwm_backlight: backlight {
                compatible = "pwm-backlight";
                pwms = <&rp1_pwm0 2 25000 0>;
                brightness-levels = <0 4 8 16 32 48 64 96 128 160 192 224 240 255>;
                default-brightness-level = <10>;
                status = "okay";
            };
        };
    };

    // ✅ NEW: Disable HDMI outputs to force DSI as primary display
    fragment@7 {
        target = <&hdmi0>;
        __overlay__ {
            status = "disabled";
        };
    };

    fragment@7a {
        target = <&hdmi1>;
        __overlay__ {
            status = "disabled";
        };
    };

    // ✅ ENABLE HVS: Hardware Video Scaler needed for video pipeline
    fragment@7b {
        target = <&hvs>;
        __overlay__ {
            status = "okay";
        };
    };

    // ✅ ENABLE VC4 DRM: Main display driver needed for complete pipeline  
    fragment@7c {
        target = <&vc4>;
        __overlay__ {
            status = "okay";
        };
    };

    // Disable power button to free GPIO20 for touch interrupt
    fragment@8 {
        target-path = "/pwr_button";
        __overlay__ {
            status = "disabled";
        };
    };

    // SPI0 CS Pin Configuration (GPIO8) 
    spi_cs_frag: fragment@9 {
        target = <&rp1_gpio>;
        __overlay__ {
            spi0_cs_pins: spi0_cs_pins {
                pins = "gpio8";
                function = "spi0";
            };
        };
    };

    // SPI Touch Device Configuration - Use SPI0 with proper GPIO configuration
    fragment@9a {
        target = <&spi0>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            cs-gpios = <&rp1_gpio 8 1>;
            status = "okay";
            // Configure all SPI pins and touch GPIO pins
            pinctrl-names = "default";
            pinctrl-0 = <&spi0_cs_pins>, <&spi0_data_pins>, <&touch_reset_pins>, <&touch_irq_pins>;
            
            himax_ts: himax_ts@0 {
                compatible = "himax,hxcommon";
                reg = <0>;  // Use chipselect 0
                spi-max-frequency = <10000000>; // 10MHz - Himax documented requirement
                // Raw module ranges; exclusive upper bounds
                himax,panel-coords   = <0 1200 0 2000>;
                // Logical screen size (width, height); driver uses [1] and [3]
                himax,display-coords = <0 1200 0 2000>;
                // Request X/Y axis swap in driver
                himax,swap-xy;
                // Invert X axis coordinates
                himax,invert-x;
                himax,irq-gpio = <&rp1_gpio 20 0x2008>;
                himax,rst-gpio = <&rp1_gpio 7 0x00>; 
                interrupt-parent = <&rp1_gpio>;
                interrupts = <20 0x2008>;
                report_type = <1>;
                /* Reference LCD panel to ensure touch waits for display */
                display-parent = <&dsi_panel>;
                /* Skip hardware reset during probe - controller already initialized */
                himax,skip-hw-reset;
                status = "okay";
            };
        };
    };

    // Disable conflicting spidev device on SPI0 controller  
    spidev_fragment: fragment@10 {
        target = <&spi0>;
        __overlay__ {
            spidev@0 {
                status = "disabled";
            };
        };
    };

    // Add no_miso support for SPI0 data pins (optional MISO line)
    fragment@11 {
        target = <&spi0_pins>;
        __dormant__ {
            brcm,pins = <10 11>;  // Only MOSI and SCLK if no MISO needed
        };
    };

    __overrides__ {
        // DSI overrides - allow switching between DSI0 and DSI1
        dsi0 = <&dsi_frag>, "target:0=",<&dsi0>;
        dsi1 = <&dsi_frag>, "target:0=",<&dsi1>;
        // SPI overrides - CS pin and MISO control  
        cs0_pin = <&spi_cs_frag>, "brcm,pins:0";
        no_miso = <0>, "=11";
    };
};