/dts-v1/;
/plugin/;

/{
    compatible = "brcm,bcm2712";

    // DSI Display Configuration
    dsi_frag: fragment@0 {
        target = <&dsi1>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            
            port {
                dsi_out: endpoint {
                    remote-endpoint = <&panel_in>;
                };
            };
            
            // ProductShop Himax HX83102E Panel as DSI device
            panel@0 {
                compatible = "himax,hx83102e", "himax,hx83102";
                reg = <0>;  // DSI virtual channel
                
                // LCD reset pin according to ProductShop pinout  
                reset-gpios = <&gpio 17 1>;  // GPIO17 (LCD_RESET), active low (1 = inverted)
                
                backlight = <&pwm_backlight>;
                rotation = <270>;
                
                port {
                    panel_in: endpoint {
                        remote-endpoint = <&dsi_out>;
                    };
                };
            };
        };
    };

    // Free GPIO7 from SPI CS1 usage
    fragment@1 {
        target = <&gpio>;
        __overlay__ {
            // Explicitly configure GPIO7 as general purpose before SPI claims it
            gpio7_touch_reset: gpio7_touch_reset {
                brcm,pins = <7>;
                brcm,function = <1>;  // Output
                brcm,pull = <0>;      // No pull
            };
        };
    };

    // SPI Touch Configuration  
    fragment@2 {
        target = <&spi0>;
        __overlay__ {
            status = "okay";
            num-cs = <1>;  // Only use CS0, disable CS1 to free GPIO7
            /delete-property/ pinctrl-0;  // Remove default pinctrl that may claim CS1
            
            himax_ts: spidev@0 {
                compatible = "himax,hxcommon";
                reg = <0>;
                spi-max-frequency = <10000000>;  // 10MHz
                
                // Pin control configuration - removed to let driver manage GPIOs
                // pinctrl-names = "default";
                // pinctrl-0 = <&touch_irq_pins &touch_reset_pins>;
                
                // Touch panel coordinates (1200x2000)
                himax,panel-coords = <0 1200 0 2000>;
                himax,display-coords = <0 1200 0 2000>;
                
                // GPIO configuration  
                himax,irq-gpio = <&gpio 20 0x2008>;  // GPIO20, IRQ_TYPE_LEVEL_LOW | IRQ_TYPE_EDGE_FALLING
                himax,rst-gpio = <&gpio 6 0x00>;     // GPIO6 - Using available pin since GPIO7 claimed by SPI CS1
                
                // Interrupt configuration
                interrupt-parent = <&gpio>;
                interrupts = <20 0x2008>;  // GPIO20, IRQ_TYPE_LEVEL_LOW | IRQ_TYPE_EDGE_FALLING
                
                // Project-specific configuration
                himax,proj-name = "productshop";
                productshop,rx-num = <50>;
                productshop,tx-num = <32>;
                productshop,bt-num = <0>;
                productshop,max-pt = <10>;
                productshop,int-edge = <1>;  // Edge trigger
                productshop,stylus-func = <0>;  // No stylus support
                
                // Protocol configuration
                report_type = <1>;  // Protocol B
                
                status = "okay";
            };
        };
    };

    // GPIO Pin Configuration
    fragment@3 {
        target = <&gpio>;
        __overlay__ {
            // Display GPIO pins
            lcd_reset_pins: lcd_reset_pins {
                brcm,pins = <17>;     // GPIO17 (LCD_RESET)
                brcm,function = <1>;  // Output
                brcm,pull = <0>;      // No pull
            };
            
            pwm_pins: pwm_pins {
                brcm,pins = <18>;     // GPIO18 (BL_PWM)
                brcm,function = <2>;  // Alt5 (PWM0)
            };
            
            // Touch GPIO pins
            spi0_pins: spi0_pins {
                brcm,pins = <8 9 10 11>;  // CS0, MISO, MOSI, SCLK
                brcm,function = <4>;      // Alt0 function for SPI0
                brcm,pull = <0>;          // No pull
            };
            
            touch_irq_pins: touch_irq_pins {
                brcm,pins = <20>;         // Touch interrupt GPIO20
                brcm,function = <0>;      // Input
                brcm,pull = <2>;          // Pull-up
            };
            
            touch_reset_pins: touch_reset_pins {
                brcm,pins = <7>;          // Touch reset GPIO7 (LCD_TOUCH_RST)
                brcm,function = <1>;      // Output
                brcm,pull = <0>;          // No pull
            };
        };
    };

    // PWM Configuration for Backlight
    fragment@4 {
        target = <&rp1_pwm0>;
        __overlay__ {
            pinctrl-names = "default";
            pinctrl-0 = <&pwm_pins>;
            status = "okay";
        };
    };

    // SPI Pin Control
    fragment@5 {
        target = <&spi0>;
        __overlay__ {
            pinctrl-names = "default";
            pinctrl-0 = <&spi0_pins>;
        };
    };

    // Backlight Device
    fragment@6 {
        target-path = "/";
        __overlay__ {
            pwm_backlight: backlight {
                compatible = "pwm-backlight";
                pwms = <&rp1_pwm0 0 20000 0>;
                brightness-levels = <0 4 8 16 32 48 64 96 128 160 192 224 240 255>;
                default-brightness-level = <10>;
                status = "okay";
            };
        };
    };

    // Add this fragment to override SPI pin configuration
    fragment@99 {
        target = <&spi0>;
        __overlay__ {
            cs-gpios = <&gpio 8 1>, <0>;  // Only CS0 on GPIO8, CS1 is null
            num-cs = <1>;
        };
    };

    // Also add a fragment to reconfigure the pinctrl
    fragment@100 {
        target = <&gpio>;
        __overlay__ {
            // Override default SPI0 pins to exclude GPIO7
            spi0_no_cs1: spi0_no_cs1 {
                brcm,pins = <8 9 10 11>;  // CS0, MISO, MOSI, SCLK (no GPIO7)
                brcm,function = <4>;      // Alt0 for SPI
            };
        };
    };

    fragment@101 {
        target = <&spi0>;
        __overlay__ {
            pinctrl-names = "default";
            pinctrl-0 = <&spi0_no_cs1>;  // Use our custom pinctrl without CS1
        };
    };

    __overrides__ {
        // DSI overrides
        dsi0 = <&dsi_frag>, "target:0=",<&dsi0>;
        
        // Touch overrides
        spi_freq = <&himax_ts>, "spi-max-frequency:0";
        irq_gpio = <&himax_ts>, "himax,irq-gpio:4",
                   <&touch_irq_pins>, "brcm,pins:0";
        rst_gpio = <&himax_ts>, "himax,rst-gpio:4",
                   <&touch_reset_pins>, "brcm,pins:0";
    };
};