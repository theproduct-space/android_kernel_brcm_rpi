/dts-v1/;
/plugin/;

/{
    compatible = "brcm,bcm2712";

    // Battery Definition
    lipo_battery: battery {
        compatible = "simple-battery";
        voltage-min-design-microvolt = <3000000>;
        voltage-max-design-microvolt = <4200000>;
        energy-full-design-microwatt-hours = <37000000>;
        charge-full-design-microamp-hours = <10000000>;
    };

    // GPIO pins for I2C devices
    fragment@0 {
        target = <&rp1_gpio>;
        __overlay__ {
            pmic_pins: pmic_pins {
                pins = "gpio6", "gpio14", "gpio21", "gpio24";
                function = "gpio";
                bias-pull-up;
            };

            // Default enables for PMIC control lines
            pmic_charge_en_hog: pmic_charge_en_hog_control {
                gpio-hog;
                gpios = <21 0>;
                output-high; // enable charging by default
                line-name = "pmic-charge-enable";
            };

            pmic_qon_hog: pmic_qon_hog_control {
                gpio-hog;
                gpios = <14 0>;
                output-high;
                line-name = "pmic-qon";
            };
        };
    };

    // I2C3 for IMU and power management
    fragment@1 {
        target = <&i2c3>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            pinctrl-0 = <&rp1_i2c3_22_23>;
            status = "okay";
            
            lsm6dsl@6b {
                compatible = "st,lsm6dsl";
                reg = <0x6b>;
                /* IMU orientation: +Y -> 0deg, +X -> 90deg (rotate +90 deg about Z)
                 * Use numeric cells; the driver expects a 3x3 matrix of integers in [-1,0,1].
                 * [ 0 -1  0 ]
                 * [ 1  0  0 ]
                 * [ 0  0  1 ]
                 */
                mount-matrix = <0 -1 0  1 0 0  0 0 1>;
                status = "okay";
            };
            
            charger@6a {
                compatible = "ti,bq25890";
                reg = <0x6a>;
                pinctrl-names = "default";
                pinctrl-0 = <&pmic_pins>;
                /* PMIC IRQ on GPIO24 (active low) */
                interrupt-parent = <&rp1_gpio>;
                interrupts = <24 8>; /* IRQ_TYPE_LEVEL_LOW */
                /* Also expose named GPIO for drivers using gpiod */
                bq25890-irq-gpios = <&rp1_gpio 24 0>;
                ti,battery-regulation-voltage = <4200000>;
                ti,charge-current = <2000000>;
                ti,termination-current = <128000>;
                ti,precharge-current = <128000>;
                ti,minimum-sys-voltage = <3000000>;
                ti,boost-voltage = <5126000>;
                ti,boost-max-current = <1400000>;
                ti,input-current-limit = <2000000>;
                monitored-battery = <&lipo_battery>;
                status = "okay";
            };

            fuel_gauge@55 {
                compatible = "ti,bq27411";
                reg = <0x55>;
                monitored-battery = <&lipo_battery>;
                status = "okay";
            };
        };
    };
};
